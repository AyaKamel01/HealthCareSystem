@model HealthCareSystem.PL.ViewModels.AppointmentViewModel

@{
    ViewData["Title"] = "Create Appointment";
}

<h1>Create Appointment</h1>

<form asp-action="Create" method="post">

    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <div class="form-group mb-3">
        <label asp-for="PatientId">Patient</label>
        <select asp-for="PatientId"
                asp-items="Model.Patients"
                class="form-control">
            <option value="">-- Select Patient --</option>
        </select>
    </div>

    <div class="form-group mb-3">
        <label asp-for="DoctorId">Doctor</label>
        <select asp-for="DoctorId"
                asp-items="Model.Doctors"
                class="form-control">
            <option value="">-- Select Doctor --</option>
        </select>
    </div>

    <div class="form-group mb-3">
        <label asp-for="AppointmentDate"></label>
        <input asp-for="AppointmentDate"
               type="datetime-local"
               class="form-control" />
        <span asp-validation-for="AppointmentDate" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary">Create</button>
    <a asp-action="Index" class="btn btn-secondary">Back to List</a>

</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}